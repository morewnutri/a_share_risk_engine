digraph AShareRiskTree {
    rankdir=TB;
    node [shape=box, style="rounded"];
    A [label="数据置信度 >= 65%\n且关键不可用 < 3?"];
    B [label="DATA_INCOMPLETE"];
    C [label="卖出分 >= 68 ?"];
    D [label="REDUCE / 偏卖出"];
    E [label="买入分 >=65 且\n上涨家数 >=60% ?"];
    F [label="BUY_BIAS / 分批偏买入"];
    G [label="买入分 >=60 ?"];
    H [label="WATCH_BUY"];
    I [label="HOLD"];
    A -> B [label="否"]; A -> C [label="是"];
    C -> D [label="是"]; C -> E [label="否"];
    E -> F [label="是"]; E -> G [label="否"];
    G -> H [label="是"]; G -> I [label="否"];
}
